# =============================================================================
# Radar IA — variables d'environnement d'exemple
# Copier vers .env et adapter. Ne jamais committer .env.
# Chargement runtime prévu : variables système, `node --env-file=.env`, Compose.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# Hors conteneur : localhost. Dans Docker, définir explicitement API_HOST=0.0.0.0.
API_HOST=127.0.0.1
API_PORT=3000

# -----------------------------------------------------------------------------
# PostgreSQL (Docker Compose — bind 127.0.0.1 uniquement)
# Données hors dépôt. Chemin hôte portable ; surcharger dans .env local si besoin
# (ex. un volume disque dédié). Ne jamais committer .env.
# Remplacer le placeholder mot de passe par un secret local fort.
# -----------------------------------------------------------------------------
POSTGRES_USER=radar
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_DB=radar_ia
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Bind mount hôte → /var/lib/postgresql/data (défaut relatif à la racine du dépôt)
POSTGRES_DATA_PATH=./data/postgres

# -----------------------------------------------------------------------------
# Connexion applicative (Prisma / @radar-ia/config)
# Doit rester cohérent avec POSTGRES_* ci-dessus pour l'accès depuis l'hôte.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://radar:change-me-in-local-env@localhost:5432/radar_ia

# -----------------------------------------------------------------------------
# Discord
# Obligatoires lorsque NODE_ENV=production.
# Optionnels hors production tant qu'aucun bot n'est démarré.
# Ne pas committer de valeurs réelles.
# -----------------------------------------------------------------------------
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ANNONCES_MAJEURES=
DISCORD_CHANNEL_VEILLE_PERTINENTE=
DISCORD_CHANNEL_FLUX_IA=
# Allowlist admin slash (IDs utilisateur Discord, séparés par des virgules — pas de rôles)
DISCORD_ADMIN_USER_IDS=

# -----------------------------------------------------------------------------
# Ollama / LLM
# Cible fonctionnelle gelée : Ministral 3 3B (Modelfile dédié).
# OLLAMA_MODEL = tag exact côté Ollama (défini à l'étape install Ollama / Modelfile).
# OLLAMA_MAX_CONCURRENCY doit rester à 1 (une seule inférence simultanée).
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_MAX_CONCURRENCY=1

# -----------------------------------------------------------------------------
# Sources (registre fichier = source de vérité de définition)
# Chemin relatif = racine monorepo (pas le cwd npm workspace apps/bot|worker).
# -----------------------------------------------------------------------------
SOURCES_REGISTRY_PATH=config/sources.json

# -----------------------------------------------------------------------------
# Worker / pipeline scheduler (009.1D)
# WORKER_SCHEDULER_ENABLED=false → mode one-shot (un cycle puis arrêt).
# Intervalles en millisecondes ; bornes validées par @radar-ia/config.
# -----------------------------------------------------------------------------
WORKER_SCHEDULER_ENABLED=true
WORKER_CYCLE_INTERVAL_MS=900000
WORKER_INITIAL_DELAY_MS=5000
PIPELINE_LOCK_TTL_MS=300000
PIPELINE_HEARTBEAT_INTERVAL_MS=30000
WORKER_HOLDER_PREFIX=worker
# Rétention snapshots bruts (010.1A AUD-008)
RAW_FEED_RETENTION_PER_SOURCE=20
RAW_FEED_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Publication Discord (constante applicative, non surchargée ici)
# Archivage des fils : 24 h (doctrine gelée — appliquée dans @radar-ia/config).
# -----------------------------------------------------------------------------
